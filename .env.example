# Server-only references. Populate a gitignored env or inject from your vault; never paste secrets into chat.
# Remains off until isolated migrations, namespace binding and native credential tests are ready.
LABSD_IDENTITY_ENABLED=0
# Private finance routes require identity plus the reconciled local store. Exposure remains separately gated.
LABSD_FINANCE_ENABLED=0
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DATABASE_URL=
# Offline reviewed-file import, independently enabled only on the selected worker target.
LABSD_IMPORT_ENABLED=0
# Absolute operator-provisioned read-only root; exports/ and independent controls/ are separate.
LABSD_REVIEW_DIRECTORY=
# Record the built source SHA for release runs; no automatic scheduler is enabled here.
LABSD_RELEASE_SHA=
