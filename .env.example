# Server-only references. Populate a gitignored env or inject from your vault; never paste secrets into chat.
# Remains off until isolated migrations, namespace binding and native credential tests are ready.
LABSD_IDENTITY_ENABLED=0
# Isolated UI experiments only; the main local runtime leaves this disabled.
LABSD_DEVELOPMENT_PREVIEWS_ENABLED=0
# Private finance routes require identity plus the reconciled local store. Exposure remains separately gated.
LABSD_FINANCE_ENABLED=0
# Independently enable statement publication; requires identity + finance. Reads stay available when off.
LABSD_STATEMENT_PUBLICATION_ENABLED=0
# Safe API response metadata to stdout + generated X-Request-ID; configure collector/retention before production.
LABSD_API_OBSERVABILITY_ENABLED=0
# Framework-captured server errors; safe events only, separate from raw framework stderr and client event handlers.
LABSD_WEB_ERROR_OBSERVABILITY_ENABLED=0

# Optional same-host service monitor; only configured capabilities are checked.
# Explicit unique loopback ports are required. No worker-port auto-discovery/defaults.
# Start: node --import tsx scripts/service-monitor.ts (or npm run services:monitor)
# LABSD_MONITOR_PORT=43200
# LABSD_MONITOR_WEB_PORT=4188
# LABSD_MONITOR_FACEBOOK_PORT=43201
# LABSD_MONITOR_TIKTOK_PORT=43202
LABSD_MONITOR_INTERVAL_MS=30000
LABSD_MONITOR_TIMEOUT_MS=3000
# Retain only sanitized service-status transitions in the monitor's own private namespace.
LABSD_MONITOR_LOG_ENABLED=0
LABSD_MONITOR_LOG_MAX_BYTES=65536
LABSD_MONITOR_LOG_MAX_FILES=4
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DATABASE_URL=
# Offline reviewed-file import, independently enabled only on the selected worker target.
LABSD_IMPORT_ENABLED=0
# Absolute operator-provisioned read-only root; exports/ and independent controls/ are separate.
LABSD_REVIEW_DIRECTORY=
# Staff can inspect/publish already agreed account-profiles/ files; no finance recalculation.
LABSD_ACCOUNT_PROFILE_ENABLED=0
# Record the built source SHA for release runs; no automatic scheduler is enabled here.
LABSD_RELEASE_SHA=
# Marketing capabilities are independent from account installation; all source activity stays off.
LABSD_MARKETING_ENABLED=0
LABSD_FACEBOOK_READ_ENABLED=0
LABSD_TIKTOK_VIDEO_ENABLED=0
# Metadata only: see docs/implementation/tiktok-shop-video-provisioning.md
LABSD_TIKTOK_VIDEO_PROFILES=[]
LABSD_TIKTOK_VIDEO_SYNC_ENABLED=0
# Owner M2M service, not seller OAuth. Configure only after owner handler installation.
LABSD_TIKTOK_OWNER_ORIGIN=
LABSD_TIKTOK_OWNER_SERVICE_TOKEN=
LABSD_MARKETING_SYNC_ENABLED=0
# Optional loopback supervisor health port; blank uses Facebook4191 or TikTok4192.
LABSD_WORKER_HEALTH_PORT=
LABSD_MARKETING_HISTORY_DAYS=90
# Metadata only. See docs/implementation/marketing-provisioning.md for the profile format.
LABSD_FACEBOOK_PROFILES=[]
# A profile refers to an injected secret NAME (for example LABSD_FB_PRIMARY_TOKEN).
# Never put token values in a provisioning command, tracked config, or browser form.

# --- Dev ad-performance snapshot preview (server-only; NEVER NEXT_PUBLIC) --------------------------
# Off by default. When '1', the operator refresh CLI and the dev-only /api/dev/ad-performance endpoint
# are active. See docs/dev/ad-performance-snapshot.md for the full binding format + security limits.
LABSD_AD_SNAPSHOT_ENABLED=0
# Server-owned STRICT allowlist (metadata only). Each entry maps a demo identity+clip to EXACTLY ONE
# ad/account/window and references a Facebook profile id (LABSD_FACEBOOK_PROFILES) for credentials.
# Nothing outside a listed entry is ever served — the endpoint accepts only identity+clip+from+to and
# matches them against this list; there is no wildcard or arbitrary-Graph proxy.
# `expectedCreativeId` is REQUIRED and `expectedVideoId` is optional: refresh verifies the ad still
# resolves to that creative (and, when set, that video) before writing, so a replaced/foreign creative
# is rejected instead of snapshotted. Window is a CLOSED, complete calendar range of 1..93 days whose
# exclusive end may not fall on an in-progress/future day. Example (single line):
# LABSD_AD_SNAPSHOT_BINDINGS=[{"identity":"a","clipId":"clip-3","profileId":"fb-primary","namespace":"meta","accountId":"1234567890","adId":"52513673563767","expectedCreativeId":"1004085732033027","expectedVideoId":"2629443027486387","currency":"THB","timezone":"Asia/Bangkok","from":"2026-07-01","toExclusive":"2026-09-01","canViewSpend":false}]
LABSD_AD_SNAPSHOT_BINDINGS=[]
# Optional project-local snapshot directory (must resolve inside the project). Default:
# .agent-work/20260917-ad-performance/snapshots
# LABSD_AD_SNAPSHOT_DIR=
