{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@marketing-ads-preview": [
        "./dev/AdRegistrationPreview.tsx"
      ],
      "@account-preview": [
        "./dev/AccountPreview.tsx"
      ],
      "@operations-preview": [
        "./dev/OperationsPreview.tsx"
      ],
      "@/*": [
        "./src/*"
      ],
      "@foundation-gallery": [
        "./dev/FoundationGallery.tsx"
      ],
      "@access-preview": [
        "./dev/AccessPreview.tsx"
      ],
      "@content-preview": [
        "./dev/ContentPreview.tsx"
      ],
      "@overview-preview": [
        "./dev/OverviewPreview.tsx"
      ],
      "@transactions-preview": [
        "./dev/TransactionsPreview.tsx"
      ],
      "@withdrawal-preview": [
        "./dev/WithdrawalPreview.tsx"
      ],
      "@demo-dataset-handler": [
        "./dev/demo-dataset/handler.ts"
      ],
      "@ad-performance-handler": [
        "./dev/ad-performance/handler.ts"
      ],
      "@partner-pitch": [
        "./dev/PitchApplication.tsx"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "dev/**/*.ts",
    "dev/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "*.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".agent-work",
    "design-preview",
    "_Reff"
  ]
}
